{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:parallel-ann:package:1",
  "title": "Immutable uint8 L2 input/index package v1",
  "type": "object",
  "required": [
    "schema_version",
    "package_kind",
    "package_id",
    "logical_dataset",
    "N",
    "D",
    "dtype",
    "metric",
    "created_at",
    "files"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "package_kind": {
      "enum": [
        "input",
        "index"
      ]
    },
    "package_id": {
      "type": "string",
      "minLength": 1
    },
    "logical_dataset": {
      "type": "string",
      "minLength": 1
    },
    "N": {
      "type": "integer",
      "minimum": 1
    },
    "D": {
      "type": "integer",
      "minimum": 1
    },
    "dtype": {
      "const": "uint8"
    },
    "metric": {
      "const": "l2"
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "role",
          "path",
          "size_bytes",
          "sha256",
          "mtime_ns",
          "dtype"
        ],
        "properties": {
          "role": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "pattern": "^/"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "mtime_ns": {
            "type": "integer",
            "minimum": 0
          },
          "dtype": {
            "type": "string",
            "minLength": 1
          },
          "vector_count": {
            "type": "integer",
            "minimum": 1
          },
          "dimension": {
            "type": "integer",
            "minimum": 1
          },
          "top_k": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "source_provenance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    },
    "conversion": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    },
    "input_package_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "index_prefix": {
      "type": "string",
      "pattern": "^/"
    },
    "parameters": {
      "type": "object",
      "required": [
        "R",
        "L",
        "pq_bytes",
        "memory_budget_GiB",
        "threads",
        "metric",
        "neighbor_type",
        "algorithm"
      ],
      "properties": {
        "R": {
          "type": "integer",
          "minimum": 1
        },
        "L": {
          "type": "integer",
          "minimum": 1
        },
        "pq_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "memory_budget_GiB": {
          "type": "integer",
          "minimum": 1
        },
        "threads": {
          "type": "integer",
          "minimum": 1
        },
        "metric": {
          "const": "l2"
        },
        "neighbor_type": {
          "const": "pq"
        },
        "algorithm": {
          "const": "Vamana"
        }
      }
    },
    "build": {
      "type": "object",
      "required": [
        "builder_binary_sha256",
        "builder_commit",
        "command",
        "timestamp_start",
        "timestamp_end",
        "wall_time_s",
        "log_path",
        "log_sha256"
      ],
      "properties": {
        "builder_binary_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "log_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "builder_commit": {
          "type": "string",
          "minLength": 1
        },
        "command": {
          "type": "string",
          "minLength": 1
        },
        "timestamp_start": {
          "type": "string",
          "minLength": 1
        },
        "timestamp_end": {
          "type": "string",
          "minLength": 1
        },
        "log_path": {
          "type": "string",
          "minLength": 1
        },
        "wall_time_s": {
          "type": "number",
          "minimum": 0
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "package_kind": {
            "const": "input"
          }
        }
      },
      "then": {
        "required": [
          "source_provenance",
          "conversion"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "package_kind": {
            "const": "index"
          }
        }
      },
      "then": {
        "required": [
          "input_package_manifest_sha256",
          "index_prefix",
          "parameters",
          "build"
        ]
      }
    }
  ]
}
