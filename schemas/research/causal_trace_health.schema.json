{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:parallel-ann:p0:causal-health:2-3",
  "type": "object",
  "required": [
    "sample_requested",
    "sample_observed",
    "buffer_capacity",
    "events_written",
    "events_dropped",
    "unmatched_submit",
    "unmatched_cqe",
    "unmatched_publish",
    "ordering_violations",
    "negative_hidden_count",
    "outstanding_at_query_end",
    "table_overflows",
    "submitted",
    "cqe_seen",
    "published",
    "expanded",
    "schema_version",
    "trace_mode",
    "sample_policy",
    "trace_valid"
  ],
  "properties": {
    "sample_requested": {
      "type": "integer",
      "minimum": 0
    },
    "sample_observed": {
      "type": "integer",
      "minimum": 0
    },
    "buffer_capacity": {
      "type": "integer",
      "minimum": 0
    },
    "events_written": {
      "type": "integer",
      "minimum": 0
    },
    "events_dropped": {
      "type": "integer",
      "minimum": 0
    },
    "unmatched_submit": {
      "type": "integer",
      "minimum": 0
    },
    "unmatched_cqe": {
      "type": "integer",
      "minimum": 0
    },
    "unmatched_publish": {
      "type": "integer",
      "minimum": 0
    },
    "ordering_violations": {
      "type": "integer",
      "minimum": 0
    },
    "negative_hidden_count": {
      "type": "integer",
      "minimum": 0
    },
    "outstanding_at_query_end": {
      "type": "integer",
      "minimum": 0
    },
    "table_overflows": {
      "type": "integer",
      "minimum": 0
    },
    "submitted": {
      "type": "integer",
      "minimum": 0
    },
    "cqe_seen": {
      "type": "integer",
      "minimum": 0
    },
    "published": {
      "type": "integer",
      "minimum": 0
    },
    "expanded": {
      "type": "integer",
      "minimum": 0
    },
    "schema_version": {
      "enum": [
        2,
        3
      ]
    },
    "trace_mode": {
      "enum": [
        "OFF",
        "LIGHT",
        "DETAIL"
      ]
    },
    "sample_policy": {
      "type": "object"
    },
    "trace_valid": {
      "type": "boolean"
    },
    "requested_sample_qids": {
      "type": "array",
      "maxItems": 1024,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 0
      }
    },
    "observed_sample_qids": {
      "type": "array",
      "maxItems": 1024,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 0
      }
    },
    "sampling_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "benchmark_origin_ns": {
      "type": "integer",
      "minimum": 0
    },
    "benchmark_end_ns": {
      "type": "integer",
      "minimum": 0
    },
    "benchmark_duration_ns": {
      "type": "integer",
      "minimum": 0
    },
    "sampled_query_phase": {
      "type": "array",
      "maxItems": 1024
    }
  },
  "additionalProperties": true,
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": 3
          }
        }
      },
      "then": {
        "required": [
          "requested_sample_qids",
          "observed_sample_qids",
          "sampling_sha256",
          "benchmark_origin_ns",
          "benchmark_end_ns",
          "benchmark_duration_ns",
          "sampled_query_phase"
        ]
      }
    }
  ]
}
