{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:parallel-ann:p0:summary:2",
  "title": "P0 summary v2",
  "type": "object",
  "required": [
    "qps",
    "recall",
    "mean_latency_us",
    "p50_latency_us",
    "p95_latency_us",
    "p99_latency_us",
    "p999_latency_us",
    "mean_hops",
    "mean_ios",
    "schema_version",
    "run_id",
    "wall_time_s",
    "exit_code",
    "run_status",
    "benchmark_profile",
    "benchmark_profile_version",
    "parser_version",
    "printed_latency_percentile",
    "printed_latency_metric"
  ],
  "properties": {
    "qps": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "recall": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 100
    },
    "mean_latency_us": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "p50_latency_us": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "p95_latency_us": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "p99_latency_us": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "p999_latency_us": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "mean_hops": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "mean_ios": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "schema_version": {
      "type": "integer",
      "const": 2
    },
    "run_id": {
      "type": "string"
    },
    "wall_time_s": {
      "type": "number",
      "minimum": 0
    },
    "exit_code": {
      "type": [
        "integer",
        "null"
      ],
      "description": "Native ANN process returncode (negative for signal termination), null when no process started. This is not the runner return code."
    },
    "run_status": {
      "type": "string",
      "enum": [
        "success",
        "failed",
        "interrupted",
        "timed_out"
      ],
      "description": "Overall experiment result. Success iff benchmark_status is success and tracing is not required or trace_valid is true. Historical v2 records lacking benchmark_status retain their original pre-correction meaning."
    },
    "benchmark_profile": {
      "enum": [
        "legacy-research",
        "pipeann-b9ec4ba"
      ]
    },
    "benchmark_profile_version": {
      "type": "string"
    },
    "parser_version": {
      "type": "string"
    },
    "printed_latency_percentile": {
      "enum": [
        0.99,
        0.999
      ]
    },
    "printed_latency_metric": {
      "enum": [
        "p99_latency_us",
        "p999_latency_us"
      ]
    },
    "trace_valid": {
      "type": [
        "boolean",
        "null"
      ],
      "description": "Required causal evidence validity; null when causal tracing is not enabled or validation is pending."
    },
    "trace_events_written": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "trace_events_dropped": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "benchmark_status": {
      "type": "string",
      "enum": [
        "success",
        "failed",
        "interrupted",
        "timed_out"
      ],
      "description": "ANN process execution plus benchmark parsing result; independent of required causal trace validity."
    },
    "causal_trace_enabled": {
      "type": "boolean"
    }
  },
  "additionalProperties": true,
  "allOf": [
    {
      "if": {
        "properties": {
          "benchmark_profile": {
            "const": "legacy-research"
          }
        }
      },
      "then": {
        "properties": {
          "benchmark_profile_version": {
            "const": "legacy-research/v1"
          },
          "printed_latency_percentile": {
            "const": 0.999
          },
          "parser_version": {
            "const": "search-table/v1"
          },
          "p99_latency_us": {
            "type": "null"
          },
          "printed_latency_metric": {
            "const": "p999_latency_us"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "benchmark_profile": {
            "const": "pipeann-b9ec4ba"
          }
        }
      },
      "then": {
        "properties": {
          "benchmark_profile_version": {
            "const": "pipeann-b9ec4ba/v1"
          },
          "printed_latency_percentile": {
            "const": 0.99
          },
          "parser_version": {
            "const": "search-table/v1"
          },
          "p999_latency_us": {
            "type": "null"
          },
          "printed_latency_metric": {
            "const": "p99_latency_us"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "benchmark_status"
        ]
      },
      "then": {
        "required": [
          "run_status",
          "trace_valid",
          "causal_trace_enabled",
          "exit_code"
        ]
      }
    }
  ]
}
