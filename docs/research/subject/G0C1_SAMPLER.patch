+static void parse_sampling(uint64_t query_count) {
+  selected_qids.clear(); membership.clear();
+  const char *policy = std::getenv("PIPEANN_TRACE_SAMPLE_POLICY");
+  const char *ids = std::getenv("PIPEANN_TRACE_SAMPLE_QIDS");
+  if (!policy || strcmp(policy, "first_n") == 0) {
+    if (ids) throw std::runtime_error("QIDS requires explicit_qids policy");
+    return;
+  }
+  if (strcmp(policy, "explicit_qids") != 0 || config.mode != DETAIL || !ids ||
+      !*ids || strnlen(ids, 16385) > 16384 || query_count > 1000000)
+    throw std::runtime_error("Invalid explicit_qids configuration");
+  std::string canonical;
+  const char *cursor = ids;
+  while (*cursor) {
+    const char *start = cursor;
+    while (*cursor >= '0' && *cursor <= '9') ++cursor;
+    if (start == cursor || (cursor-start > 1 && *start == '0') || (*cursor && *cursor != ','))
+      throw std::runtime_error("Noncanonical query ID");
+    errno = 0; char *end = nullptr; uint64_t qid = strtoull(start, &end, 10);
+    if (errno || end != cursor || qid >= query_count ||
+        (!selected_qids.empty() && qid <= selected_qids.back()) || selected_qids.size() == 1024)
+      throw std::runtime_error("Unsorted/duplicate/out-of-range query IDs");
+    selected_qids.push_back(qid);
+    if (!canonical.empty()) canonical += ',';
+    canonical.append(start, cursor-start);
+    if (*cursor && !*++cursor) throw std::runtime_error("Trailing sample separator");
+  }
+  sampling_digest = sample_sha256(canonical + "\n");
+  membership.assign(query_count, 0);
+  for (auto qid : selected_qids) membership[qid] = 1;
+  config.explicit_qids = true; config.membership = membership.data();
+}
 
