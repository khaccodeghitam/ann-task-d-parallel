+// Standalone numeric tracer test: no dataset, ANN library, io_uring or root needed.
+#include "causal_trace.h"
+#include <cassert>
+#include <cstdlib>
+#include <cstdio>
+#include <stdexcept>
+using namespace pipeann::trace;
+static void configure(const char *mode, const char *capacity = "128") {
+  setenv("PIPEANN_TRACE_MODE", mode, 1);
+  setenv("PIPEANN_TRACE_OUTPUT", "/tmp/not-written-by-tracer-unit-test", 1);
+  setenv("PIPEANN_TRACE_DETAIL_FIRST_N", "1", 1);
+  setenv("PIPEANN_TRACE_EVENT_CAPACITY", capacity, 1);
+  prepare(1, 2);
+}
+int main() {
+  configure("OFF"); begin(0, 0); width_init(4, 32, nullptr);
+  select(reinterpret_cast<void *>(8), 1, 2, 3, 0, 4096, 0);
+  submit(reinterpret_cast<void *>(8)); cqe(reinterpret_cast<void *>(8), 1, 4096);
+  publish(reinterpret_cast<void *>(8), 1); expand(1, 0); end();
+  assert(current == nullptr && workers.empty() && summaries.empty());
+  configure("DETAIL"); begin(1, 0); width_init(4, 32, nullptr); end();
+  assert(workers[0].count == 0 && summaries[1][C_SAMPLED] == 0);
+  begin(0, 0); width_init(4, 32, reinterpret_cast<void *>(16));
+  void *a = reinterpret_cast<void *>(64), *b = reinterpret_cast<void *>(128);
+  select(a, 1, 10, 11, 0, 4096, 0); submit(a);
+  select(b, 2, 20, 21, 4096, 4096, 1); submit(b);
+  poll_result(2); cqe(b, 2, 4096); cqe(a, 2, 4096);
+  assert(current->counters[C_MAX_HIDDEN] == 2);
+  publish(a, 2); publish(b, 1); expand(1, 0);
+  width_change(4, 5, 9, 10, 1, 0, 8, 0);
+  // Reuse the same address only after publication; correlation seq must change.
+  select(a, 3, 30, 31, 8192, 4096, 0); cache_ready(a); publish(a, 1);
+  end(123000);
+  auto c = summaries[0];
+  assert(c[C_SUBMITTED] == 2 && c[C_CQE] == 2 && c[C_PUBLISHED] == 2);
+  assert(c[C_OUTSTANDING] == 0 && c[C_ORDERING] == 0 && c[C_DROPPED] == 0);
+  assert(c[C_CACHE_READY] == 1 && c[C_CACHE_PUBLISHED] == 1);
+  assert(c[C_INITIAL_WIDTH] == 4 && c[C_FINAL_WIDTH] == 5 && c[C_WIDTH_CHANGES] == 1);
+  assert(c[C_LATENCY_NS] == 123000 && c[C_SELECTED] == 3);
+  configure("LIGHT"); begin(0, 0); width_init(4, 32, nullptr); end();
+  assert(workers[0].count == 0 && summaries[0][C_EVENTS_WRITTEN] == 0);
+  configure("DETAIL", "1"); begin(0, 0); width_init(4, 32, nullptr); end();
+  assert(workers[0].count == 1 && summaries[0][C_DROPPED] == 3);
+  configure("LIGHT"); begin(0, 0);
+  for (size_t i = 0; i < TABLE_CAPACITY + 1; ++i)
+    select(reinterpret_cast<void *>((i + 1) * 8), i, 0, 0, 0, 4096, i);
+  assert(current->counters[C_TABLE_OVERFLOWS] == 1); end();
+  for (const char *bad : {"oops", "", "off"}) {
+    bool threw = false; try { configure(bad); } catch (const std::runtime_error &) { threw = true; }
+    assert(threw);
+  }
+  bool threw = false; try { configure("DETAIL", "-1"); } catch (const std::runtime_error &) { threw = true; }
+  assert(threw);
+  std::puts("causal tracer tests passed: OFF, sampling, correlation reuse/FIFO, cache, width, LIGHT, overflow, config");
