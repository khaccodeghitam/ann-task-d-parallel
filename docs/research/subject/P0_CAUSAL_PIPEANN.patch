diff --git a/include/causal_trace.h b/include/causal_trace.h
new file mode 100644
index 0000000..939f787
--- /dev/null
+++ b/include/causal_trace.h
@@ -0,0 +1,207 @@
+#pragma once
+// P0 observation only. No ANN objects, request layouts, or search decisions are changed.
+#include <array>
+#include <algorithm>
+#include <cstdint>
+#include <memory>
+#include <vector>
+#include <chrono>
+#include <unistd.h>
+#include <sys/syscall.h>
+
+namespace pipeann::trace {
+constexpr uint64_t NA = UINT64_MAX;
+constexpr size_t TABLE_CAPACITY = 512;  // Stock MAX_N_SECTOR_READS is 128.
+enum Mode : uint64_t { OFF = 0, LIGHT = 1, DETAIL = 2 };
+enum Kind : uint64_t { QUERY_START = 1, QUERY_END, WIDTH_INIT, WIDTH_CHANGE, IO_SELECT,
+                      IO_SUBMIT, IO_CQE_SEEN, IO_PUBLISH, NODE_EXPAND, TRACE_HEALTH, IO_CACHE_READY };
+enum Field : size_t { TYPE, TIME_NS, QID, WORKER, TID, RING, SEQ, KEY, NODE, PAGE, LOC,
+                     OFFSET, LENGTH, WIDTH, WCAP, OLD_WIDTH, CUR_N_IN, CUR_TOT, N_IN, N_OUT,
+                     MAX_MARKER, INFLIGHT, POLL_CQES, SUBMITTED, CQE_SEEN, PUBLISHED, EXPANDED,
+                     HIDDEN, CACHE_READY, CACHE_PUBLISHED, DROPPED, ORDERING, OUTSTANDING,
+                     RESULT, EVENT_FIELDS };
+enum Counter : size_t { C_QID, C_WORKER, C_TID, C_SAMPLED, C_SELECTED, C_SUBMITTED, C_CQE,
+    C_PUBLISHED, C_EXPANDED, C_POLL_CALLS, C_CQE_COUNT, C_MAX_HIDDEN, C_INITIAL_WIDTH,
+    C_FINAL_WIDTH, C_WIDTH_CHANGES, C_MAX_INFLIGHT, C_DROPPED, C_UNMATCHED_SUBMIT,
+    C_UNMATCHED_CQE, C_UNMATCHED_PUBLISH, C_ORDERING, C_NEGATIVE_HIDDEN,
+    C_OUTSTANDING, C_CACHE_READY, C_CACHE_PUBLISHED, C_LATENCY_NS, C_TABLE_OVERFLOWS,
+    C_EVENTS_WRITTEN, COUNTER_FIELDS };
+using TraceEvent = std::array<uint64_t, EVENT_FIELDS>;
+using QueryCounters = std::array<uint64_t, COUNTER_FIELDS>;
+struct Correlation {
+  uintptr_t key = 0;  // 0 empty, 1 tombstone; real pointers are aligned.
+  uint64_t seq = 0, node = NA, page = NA, loc = NA, offset = NA, length = NA;
+  uint64_t submit_ns = NA, cqe_ns = NA, publish_ns = NA;
+  uint8_t state = 0;  // 1 selected, 2 submitted, 3 CQE ready, 4 cache ready.
+};
+struct WorkerState {
+  std::array<Correlation, TABLE_CAPACITY> requests{};
+  std::unique_ptr<TraceEvent[]> events;
+  uint64_t count = 0, capacity = 0, tid = 0, ring = NA, width = NA, wcap = NA;
+  uint64_t inflight = 0, seq = 0, next_publish = 1, query_event_start = 0;
+  bool sampled = false;
+  QueryCounters counters{};
+};
+struct Config { Mode mode = OFF; uint64_t first_n = 8, capacity = 16384, queries = 0, workers = 0; };
+extern Config config;
+extern std::vector<WorkerState> workers;
+extern std::vector<QueryCounters> summaries;
+extern thread_local WorkerState *current;
+void prepare(uint64_t worker_count, uint64_t query_count);
+void dump();  // Exclusive binary dump after the measured loop; may throw outside hot path.
+
+inline uint64_t now_ns() {
+  return std::chrono::duration_cast<std::chrono::nanoseconds>(
+      std::chrono::steady_clock::now().time_since_epoch()).count();
+}
+inline Correlation *lookup(WorkerState &s, uintptr_t key, bool insert = false) {
+  const size_t start = ((key >> 3) * 11400714819323198485ull) & (TABLE_CAPACITY - 1);
+  Correlation *free_slot = nullptr;
+  for (size_t i = 0; i < TABLE_CAPACITY; ++i) {
+    auto &slot = s.requests[(start + i) & (TABLE_CAPACITY - 1)];
+    if (slot.key == key) return &slot;
+    if (slot.key <= 1 && free_slot == nullptr) free_slot = &slot;
+    if (slot.key == 0) break;
+  }
+  return insert ? free_slot : nullptr;
+}
+inline uint64_t hidden(WorkerState &s) {
+  auto &c = s.counters;
+  if (c[C_PUBLISHED] > c[C_CQE]) { ++c[C_NEGATIVE_HIDDEN]; return NA; }
+  return c[C_CQE] - c[C_PUBLISHED];
+}
+inline TraceEvent blank_event() { TraceEvent e; e.fill(NA); return e; }
+inline void emit(Kind kind, Correlation *r = nullptr, const TraceEvent *extra = nullptr) {
+  auto *s = current;
+  if (!s || !s->sampled) return;
+  if (s->count == s->capacity) { ++s->counters[C_DROPPED]; return; }
+  // No timestamp call on OFF/LIGHT/unsampled DETAIL, or after buffer overflow.
+  TraceEvent e;
+  e.fill(NA);
+  e[TYPE] = kind; e[TIME_NS] = now_ns();
+  if (r) {
+    if (kind == IO_SUBMIT) r->submit_ns = e[TIME_NS];
+    if (kind == IO_CQE_SEEN) r->cqe_ns = e[TIME_NS];
+    if (kind == IO_PUBLISH) r->publish_ns = e[TIME_NS];
+  }
+  e[QID] = s->counters[C_QID]; e[WORKER] = s->counters[C_WORKER]; e[TID] = s->tid;
+  e[RING] = s->ring; e[WIDTH] = s->width; e[WCAP] = s->wcap; e[INFLIGHT] = s->inflight;
+  auto &c = s->counters;
+  e[SUBMITTED] = c[C_SUBMITTED]; e[CQE_SEEN] = c[C_CQE]; e[PUBLISHED] = c[C_PUBLISHED];
+  e[EXPANDED] = c[C_EXPANDED]; e[HIDDEN] = hidden(*s);
+  e[CACHE_READY] = c[C_CACHE_READY]; e[CACHE_PUBLISHED] = c[C_CACHE_PUBLISHED];
+  e[DROPPED] = c[C_DROPPED]; e[ORDERING] = c[C_ORDERING]; e[OUTSTANDING] = c[C_OUTSTANDING];
+  if (r) { e[SEQ] = r->seq; e[KEY] = r->key; e[NODE] = r->node; e[PAGE] = r->page;
+           e[LOC] = r->loc; e[OFFSET] = r->offset; e[LENGTH] = r->length; }
+  // Explicit extras are only these numeric fields, and never part of algorithm state.
+  for (size_t field : {OLD_WIDTH, CUR_N_IN, CUR_TOT, N_IN, N_OUT, MAX_MARKER, POLL_CQES, RESULT})
+    e[field] = extra ? (*extra)[field] : NA;
+  if (kind == NODE_EXPAND) e[NODE] = (*extra)[NODE];
+  s->events[s->count++] = e;
+}
+inline void begin(uint64_t qid, uint64_t worker) {
+  if (config.mode == OFF) return;
+  auto &s = workers[worker];
+  s.requests = {}; s.counters = {}; s.seq = 0; s.next_publish = 1;
+  s.inflight = 0; s.width = s.wcap = s.ring = NA; s.query_event_start = s.count;
+  s.sampled = config.mode == DETAIL && qid < config.first_n;
+  if (!s.tid) s.tid = syscall(SYS_gettid);
+  s.counters[C_QID] = qid; s.counters[C_WORKER] = worker; s.counters[C_TID] = s.tid;
+  s.counters[C_SAMPLED] = s.sampled; current = &s;
+  emit(QUERY_START);
+}
+inline void end(uint64_t latency_ns = NA) {
+  auto *s = current;
+  if (!s) return;
+  for (auto &r : s->requests) if (r.key > 1 && r.state == 1) ++s->counters[C_UNMATCHED_SUBMIT];
+  s->counters[C_LATENCY_NS] = latency_ns;
+  emit(QUERY_END); emit(TRACE_HEALTH);
+  s->counters[C_EVENTS_WRITTEN] = s->count - s->query_event_start;
+  summaries[s->counters[C_QID]] = s->counters;
+  current = nullptr;
+}
+struct QueryScope {
+  const double *latency_us;
+  QueryScope(uint64_t qid, uint64_t worker, const double *latency) : latency_us(latency) { begin(qid, worker); }
+  ~QueryScope() { if (current) end(latency_us ? static_cast<uint64_t>(*latency_us * 1000) : NA); }
+  QueryScope(const QueryScope &) = delete;
+  QueryScope &operator=(const QueryScope &) = delete;
+};
+inline void width_init(uint64_t width, uint64_t wcap, void *ctx) {
+  if (!current) return;
+  current->width = width; current->wcap = wcap; current->ring = reinterpret_cast<uintptr_t>(ctx);
+  current->counters[C_INITIAL_WIDTH] = current->counters[C_FINAL_WIDTH] = width;
+  emit(WIDTH_INIT);
+}
+inline void width_change(uint64_t old_width, uint64_t width, uint64_t cur_n_in, uint64_t cur_tot,
+                         uint64_t n_in, uint64_t n_out, uint64_t max_marker, uint64_t inflight) {
+  if (!current || old_width == width) return;
+  current->width = width; current->inflight = inflight;
+  current->counters[C_FINAL_WIDTH] = width; ++current->counters[C_WIDTH_CHANGES];
+  if (width < old_width || width > old_width + 1 || width > current->wcap) ++current->counters[C_ORDERING];
+  if (!current->sampled) return;
+  TraceEvent extra = blank_event(); extra[OLD_WIDTH] = old_width; extra[CUR_N_IN] = cur_n_in; extra[CUR_TOT] = cur_tot;
+  extra[N_IN] = n_in; extra[N_OUT] = n_out; extra[MAX_MARKER] = max_marker;
+  emit(WIDTH_CHANGE, nullptr, &extra);
+}
+inline void select(void *request, uint64_t node, uint64_t page, uint64_t loc,
+                   uint64_t offset, uint64_t length, uint64_t inflight) {
+  if (!current) return;
+  auto &s = *current; auto key = reinterpret_cast<uintptr_t>(request);
+  ++s.counters[C_SELECTED]; ++s.seq;
+  auto *r = lookup(s, key, true);
+  if (!r || r->key > 1) { ++s.counters[C_TABLE_OVERFLOWS]; ++s.counters[C_ORDERING]; return; }
+  *r = Correlation{}; r->key = key; r->seq = s.seq; r->state = 1;
+  r->node = node; r->page = page; r->loc = loc; r->offset = offset; r->length = length;
+  ++s.counters[C_OUTSTANDING]; s.inflight = inflight + 1;
+  s.counters[C_MAX_INFLIGHT] = std::max(s.counters[C_MAX_INFLIGHT], s.inflight);
+  emit(IO_SELECT, r);
+}
+inline void submit(void *request) {
+  if (!current) return;
+  auto &s = *current; auto *r = lookup(s, reinterpret_cast<uintptr_t>(request));
+  if (!r) { ++s.counters[C_UNMATCHED_SUBMIT]; return; }
+  if (r->state != 1) ++s.counters[C_ORDERING];
+  r->state = 2; ++s.counters[C_SUBMITTED];
+  emit(IO_SUBMIT, r);
+}
+inline void poll_result(uint64_t count) {
+  if (!current) return;
+  ++current->counters[C_POLL_CALLS]; current->counters[C_CQE_COUNT] += count;
+}
+inline void cqe(void *request, uint64_t batch, int result) {
+  if (!current) return;
+  auto &s = *current; auto *r = lookup(s, reinterpret_cast<uintptr_t>(request));
+  if (!r) { ++s.counters[C_UNMATCHED_CQE]; return; }
+  if (r->state != 2 || result < 0) ++s.counters[C_ORDERING];
+  r->state = 3; ++s.counters[C_CQE];
+  s.counters[C_MAX_HIDDEN] = std::max(s.counters[C_MAX_HIDDEN], hidden(s));
+  if (!s.sampled) return;
+  TraceEvent extra = blank_event(); extra[POLL_CQES] = batch; extra[RESULT] = static_cast<uint64_t>(static_cast<int64_t>(result));
+  emit(IO_CQE_SEEN, r, &extra);
+}
+inline void cache_ready(void *request) {
+  if (!current) return;
+  auto &s = *current; auto *r = lookup(s, reinterpret_cast<uintptr_t>(request));
+  if (!r) { ++s.counters[C_UNMATCHED_CQE]; return; }
+  if (r->state != 1) ++s.counters[C_ORDERING];
+  r->state = 4; ++s.counters[C_CACHE_READY]; emit(IO_CACHE_READY, r);
+}
+inline void publish(void *request, uint64_t inflight) {
+  if (!current) return;
+  auto &s = *current; auto *r = lookup(s, reinterpret_cast<uintptr_t>(request));
+  if (!r) { ++s.counters[C_UNMATCHED_PUBLISH]; return; }
+  if (r->seq != s.next_publish++) ++s.counters[C_ORDERING];
+  if (r->state == 3) ++s.counters[C_PUBLISHED];
+  else if (r->state == 4) ++s.counters[C_CACHE_PUBLISHED];
+  else { ++s.counters[C_UNMATCHED_PUBLISH]; ++s.counters[C_ORDERING]; }
+  --s.counters[C_OUTSTANDING]; s.inflight = inflight - 1;
+  emit(IO_PUBLISH, r); r->key = 1; r->state = 0;
+}
+inline void expand(uint64_t node, uint64_t inflight) {
+  if (!current) return;
+  ++current->counters[C_EXPANDED]; current->inflight = inflight;
+  if (!current->sampled) return;
+  TraceEvent extra = blank_event(); extra[NODE] = node; emit(NODE_EXPAND, nullptr, &extra);
+}
+}  // namespace pipeann::trace
