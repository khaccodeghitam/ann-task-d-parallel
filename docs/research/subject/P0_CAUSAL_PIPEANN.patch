diff --git a/src/utils/causal_trace.cpp b/src/utils/causal_trace.cpp
new file mode 100644
index 0000000..60fbe6e
--- /dev/null
+++ b/src/utils/causal_trace.cpp
@@ -0,0 +1,63 @@
+#include "causal_trace.h"
+#include <cstdio>
+#include <cerrno>
+#include <cstdlib>
+#include <cstring>
+#include <stdexcept>
+#include <string>
+
+namespace pipeann::trace {
+Config config;
+std::vector<WorkerState> workers;
+std::vector<QueryCounters> summaries;
+thread_local WorkerState *current = nullptr;
+static std::string output;
+
+static uint64_t number(const char *name, uint64_t fallback, uint64_t maximum) {
+  const char *value = std::getenv(name);
+  if (!value) return fallback;
+  if (!*value || strspn(value, "0123456789") != strlen(value)) throw std::runtime_error(name);
+  errno = 0; char *end = nullptr;
+  auto n = strtoull(value, &end, 10);
+  if (errno || *end || n > maximum) throw std::runtime_error(name);
+  return n;
+}
+void prepare(uint64_t worker_count, uint64_t query_count) {
+  config = Config{}; workers.clear(); summaries.clear(); current = nullptr;
+  const char *mode = std::getenv("PIPEANN_TRACE_MODE");
+  if (mode && strcmp(mode, "OFF") != 0) {
+    if (strcmp(mode, "LIGHT") == 0) config.mode = LIGHT;
+    else if (strcmp(mode, "DETAIL") == 0) config.mode = DETAIL;
+    else throw std::runtime_error("Invalid PIPEANN_TRACE_MODE");
+  }
+  config.first_n = number("PIPEANN_TRACE_DETAIL_FIRST_N", 8, 1000000);
+  config.capacity = number("PIPEANN_TRACE_EVENT_CAPACITY", 16384, 1048576);
+  if (!config.capacity || (config.mode == DETAIL && !config.first_n)) throw std::runtime_error("Invalid trace capacity/sample");
+  const char *path = std::getenv("PIPEANN_TRACE_OUTPUT"); output = path ? path : "";
+  if (config.mode != OFF && output.empty()) throw std::runtime_error("PIPEANN_TRACE_OUTPUT required");
+  config.workers = worker_count; config.queries = query_count;
+  if (config.mode == OFF) return;  // No event arrays, tables, or query rows allocated.
+  workers.resize(worker_count); summaries.resize(query_count);
+  for (auto &s : workers) {
+    s.capacity = config.capacity;
+    if (config.mode == DETAIL) s.events = std::make_unique<TraceEvent[]>(config.capacity);
+  }
+}
+void dump() {
+  if (output.empty()) return;
+  uint64_t event_count = 0;
+  for (auto &s : workers) event_count += s.count;
+  // Fixed protocol is little-endian uint64 arrays on the canonical Linux x86-64 host.
+  const uint16_t endian = 1;
+  if (*reinterpret_cast<const uint8_t *>(&endian) != 1) throw std::runtime_error("Trace protocol requires little endian");
+  uint64_t header[] = {1, config.mode, config.workers, config.capacity, config.first_n,
+                       config.queries, event_count, summaries.size(), EVENT_FIELDS, COUNTER_FIELDS};
+  FILE *f = std::fopen(output.c_str(), "wbx");
+  if (!f) throw std::runtime_error("Cannot create exclusive trace output");
+  bool ok = fwrite("PANTRC01", 8, 1, f) == 1 && fwrite(header, sizeof(header), 1, f) == 1;
+  for (auto &s : workers) if (s.count) ok = ok && fwrite(s.events.get(), sizeof(TraceEvent), s.count, f) == s.count;
+  if (!summaries.empty()) ok = ok && fwrite(summaries.data(), sizeof(QueryCounters), summaries.size(), f) == summaries.size();
+  ok = (fclose(f) == 0) && ok;
+  if (!ok) throw std::runtime_error("Trace output write failed");
+}
+}  // namespace pipeann::trace
